{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tiennhm-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  // Route chỉ chạy khi bản ghi DNS của tiennhm.io.vn bật proxy (đám mây cam).
  // Mọi path khác vẫn đi thẳng tới GitHub Pages.
  "routes": [{ "pattern": "tiennhm.io.vn/mcp*", "zone_name": "tiennhm.io.vn" }],
  // Giữ thêm URL *.workers.dev để thử trước khi bật proxy.
  "workers_dev": true,
  "vars": {
    "SITE_ORIGIN": "https://tiennhm.io.vn"
  },
  "observability": { "enabled": true }
}
