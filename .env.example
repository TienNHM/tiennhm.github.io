# Mẫu biến môi trường. Copy thành `.env.local` rồi điền giá trị:
#   cp .env.example .env.local
#
# Chỉ `.env.local` được đọc (docusaurus.config.js và docusaurus-plugin-dotenv),
# và nó đã nằm trong .gitignore. Trên CI, các giá trị lấy từ GitHub Secrets
# (xem .github/workflows/deploy.yml). Đừng commit giá trị thật vào repo.

# Canny
CANNY_BOARD_TOKEN=

# Google
GOOGLE_SITE_VERIFICATION=
GOOGLE_TAG_MANAGER_ID=
GTAG_TRACKING_ID=

# Microsoft Clarity (bỏ trống thì dùng ID mặc định trong config/head-tags.js)
CLARITY_PROJECT_ID=

# GitHub (Giscus)
REPO_GITHUB=
REPO_GITHUB_ID=
REPO_GITHUB_CATEGORY_ID=

# Algolia
ALGOLIA_APP_ID=
ALGOLIA_API_KEY=
ALGOLIA_INDEX_NAME=

# Firebase
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

MEIGEN_API_TOKEN=
